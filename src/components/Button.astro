---
interface Props {
  href: string;
  target?: string;
  bg?: "clear" | "filled";
  class?: string;
}

const { href, target, bg = "clear" } = Astro.props;
---

<a
  href={href}
  target={target}
  class:list={[
    "rounded-md px-4 py-3 font-mono transition-all duration-300 hover:scale-105",
    bg === "clear" && "bg-transparent",
    bg === "filled" &&
      "border border-neutral-900 bg-neutral-950 shadow-xl shadow-black",
    Astro.props.class,
  ]}
>
  <slot />
</a>
