---
import Logo from "@/lib/Logo.astro";
import Button from "@/components/Button.astro";
---

<header
  class="pointer-events-none fixed top-0 left-0 flex w-full justify-center pb-20 z-40"
>
  <div class="absolute inset-0"></div>
  <nav class="flex w-full max-w-6xl items-center justify-between px-6 py-8">
    <a
      href="/"
      class="pointer-events-auto relative z-20 transition-transform duration-300 hover:scale-110 hover:-rotate-6 [&>svg]:hover:text-white"
    >
      <Logo class="w-10 transition-colors duration-300 md:w-14" />
    </a>
    <Button
      href="mailto:verdu@live.com?subject=Contacto%20web%20🚀"
      bg="filled"
      class="pointer-events-auto z-10 text-gray-300 hover:text-white"
    >
      Contact me
    </Button>
  </nav>
</header>

<style>
  div {
    background-image: radial-gradient(black, transparent);
    background-size: 4px 4px;
    mask: linear-gradient(black, transparent);
  }
</style>
