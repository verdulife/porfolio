---
import Logo from "@/lib/Logo.astro";
import Button from "@/components/Button.astro";
---

<header class="fixed left-0 top-0 flex w-full justify-center pointer-events-none">
  <nav class="flex w-full items-center justify-between py-8 px-4 max-w-6xl">
    <a href="/" class="relative z-20 pointer-events-auto hover:-rotate-6 [&>svg]:hover:text-white hover:scale-110 duration-300 transition-transform">
      <Logo class="w-10 md:w-14 transition-colors duration-300" />
    </a>
    <Button href="mailto:verdu@live.com?subject=Contacto%20web%20🚀" bg="filled" class="pointer-events-auto"> Contact me </Button>
  </nav>
</header>
