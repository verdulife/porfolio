---
const { data } = Astro.props;
const { url, title, icon, technologies } = data;
---

<a href={url} target="_blank" class="w-full transition-all">
  <article
    class="relative mb-2 flex w-full md:min-h-[200px] md:min-w-64 flex-col items-start justify-between gap-2 md:gap-8 overflow-clip rounded-md border border-stone-900 bg-stone-950 md:p-6 p-4 pr-12 shadow-xl shadow-black duration-300 hover:z-10 hover:scale-105 odd:hover:-rotate-1 even:hover:rotate-1 md:mb-0"
  >
    <figure
      class="top-6 right-6 size-8 rounded-full border border-neutral-900 bg-neutral-900/70 p-1 backdrop-blur md:absolute"
    >
      <img
        src={icon}
        alt={`${title} - Favicon`}
        class="size-full object-contain"
      />
    </figure>

    <header class="z-10 flex items-center gap-2 md:max-w-3/4">
      <h3 class="text-lg md:text-3xl">
        {title}
      </h3>
    </header>

    <footer class="z-10 mt-4 flex w-full items-center gap-1">
      <ul class="flex flex-wrap gap-1">
        {
          technologies.map((tech: string) => (
            <li class="inline-block rounded-md bg-neutral-900 px-2 py-1 text-xs">
              {tech}
            </li>
          ))
        }
      </ul>
    </footer>
  </article>
</a>

<style>
  img.card {
    mask: linear-gradient(to right, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.6));
  }
</style>
