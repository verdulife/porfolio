---
const { data } = Astro.props;
const { url, title, image, icon, technologies } = data;
---

<a href={url} target="_blank" class="w-full transition-all">
  <article
    class="relative flex size-full min-h-[200px] flex-col items-start justify-end gap-8 overflow-clip rounded-md border border-stone-900 bg-stone-950 p-6 pr-12 shadow-xl shadow-black duration-300 hover:z-10 hover:scale-105 odd:hover:-rotate-1 even:hover:rotate-1"
  >
    {
      image && (
        <img
          loading="lazy"
          decoding="async"
          src={image}
          alt={`${title} - Logotype`}
          class="card absolute inset-0 size-full object-cover"
        />
      )
    }

    <figure
      class="absolute top-6 right-6 size-8 bg-neutral-900/70 backdrop-blur border border-neutral-900 p-1 rounded-full"
    >
      <img src={icon} alt={`${title} - Favicon`} class="size-full object-contain" />
    </figure>

    <header class="z-10 flex max-w-3/4 items-center gap-2">
      <h3 class="text-4xl">
        {title}
      </h3>
    </header>

    <footer class="z-10 mt-4 flex w-full items-center gap-1">
      <ul class="flex gap-1">
        {
          technologies.map((tech: string) => (
            <li class="inline-block rounded-md bg-neutral-900 px-2 py-1 text-xs capitalize">
              {tech}
            </li>
          ))
        }
      </ul>
    </footer>
  </article>
</a>

<style>
  img.card {
    mask: linear-gradient(to right, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.6));
  }
</style>
