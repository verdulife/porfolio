---
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/lib/projects";
---

<section
  id="my-projects"
  class="flex w-full flex-col items-start pt-20 pb-40 md:pt-56"
>
  <h2
    class="-mb-[0.25cap] bg-gradient-to-b from-neutral-300 from-50% to-black to-85% bg-clip-text pl-4 text-6xl text-transparent md:text-8xl"
  >
    Projects
  </h2>

  <ul class="flex w-full flex-wrap gap-3">
    {
      projects.map((project) => (
        <li class="grow odd:[&_article]:hover:-rotate-1 even:[&_article]:hover:rotate-1">
          <ProjectCard data={project} />
        </li>
      ))
    }
  </ul>
</section>
