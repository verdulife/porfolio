---
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/lib/projects";
---

<section
  id="my-projects"
  class="flex w-full flex-col items-start pt-20 pb-40 md:pt-56"
>
  <header class="flex w-full items-center justify-between gap-2 px-4 md:gap-4">
    <h2
      class="-mb-[0.25cap] bg-gradient-to-b from-neutral-300 from-50% to-black to-85% bg-clip-text text-5xl text-transparent md:text-7xl"
    >
      Projects
    </h2>
  </header>

  <ul class="flex w-full flex-wrap gap-2 md:gap-3">
    {
      projects.map((project) => (
        <li class="grow odd:[&_article]:hover:-rotate-1 even:[&_article]:hover:rotate-1">
          <ProjectCard data={project} />
        </li>
      ))
    }
  </ul>
</section>
