---
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/lib/projects";
---

<section
  id="my-projects"
  class="flex flex-col w-full items-start pt-20 pb-40 md:pt-56"
>
  <h2 class="text-6xl md:text-8xl pl-4 -mb-[0.25cap] text-transparent bg-gradient-to-b from-gray-300 to-black from-50% to-85% bg-clip-text">Projects</h2>

  <ul class="row-span-1 grid grid-cols-1 gap-3 md:grid-cols-2 w-full">
    {
      projects.map((project) => (
        <li>
          <ProjectCard data={project} />
        </li>
      ))
    }
  </ul>
</section>
